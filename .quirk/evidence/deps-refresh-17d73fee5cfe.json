  "claims": [
    {
      "claim_id": "qclaim.deps-refresh.17d73fee5cfe",
      "claim_type": "evidence",
      "authority_effect": "none",
      "statement": "The scaffold refreshes 33 direct dependencies to their latest in-range versions and moves vitest and @vitest/coverage-v8 from 3.2.7 to 4.1.11. 4.1.11 is the first release that fixes GHSA-82fw-gwwq-j7x9 (vulnerable range >=2.1.0 <4.1.11) and is still engines-compatible with the declared Node floor of >=20.0.0, which vitest 5 is not (its engines are ^22.12.0 || ^24.0.0 || >=26.0.0). The vite ^6.4.3 override and the engines field are both unchanged. vitest.config.ts drops a UserConfig plugins cast that vitest 4 makes unnecessary. Full-tree advisories fall from 31 to 2; both that remain are dev-path with no safe fix (braces 3.0.3 is both latest and vulnerable; the old esbuild arrives through the deprecated @esbuild-kit chain under drizzle-kit). bun audit --prod reports no vulnerabilities. This receipt binds only these three changed paths at the subject commit. It grants no merge, admission, runtime, or fleet-rollout authority and establishes no owner review.",
      "evidence_paths": [
        ".quirk/evidence/deps-refresh-1f86b7ab2367.json",
        "bun.lock",
        "package.json",
        "vitest.config.ts"
      ]
    }
