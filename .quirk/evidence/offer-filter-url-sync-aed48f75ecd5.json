  "claims": [
    {
      "claim_id": "qclaim.offer-filter-url-sync.aed48f75ecd5",
      "claim_type": "evidence",
      "authority_effect": "none",
      "statement": "OffersBoard reads ?status= through useSearchParams (inside a Suspense boundary on the page) and adopts the URL's filter whenever it changes, so a soft navigation that drops or changes ?status= no longer leaves a stale filter pressed; choosing a filter still mirrors it into the URL with history.replaceState and preserves other query parameters. Under the open, claimed, or retired filter an empty list says nothing matches that filter instead of 'No offers minted yet'. Unit tests (jsdom, next/navigation mocked to read window.location) cover both; the empty-filter test fails on the previous component. bun run validate exits 0. Soft-navigation behaviour in a real browser and screen-reader output are not exercised; owner review is not established.",
      "evidence_paths": [
        "src/app/quirk/offers/page.tsx",
        "src/components/quirk/OffersBoard.test.tsx",
        "src/components/quirk/OffersBoard.tsx"
      ]
    },
    {
