{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quirk.systems/schemas/quirk-containment-contract.schema.json",
  "title": "Quirk Containment Contract",
  "description": "Minimum deployable governance unit binding Capability Surface, Permission Knife, and Evidence Receipt.",
  "type": "object",
  "required": [
    "contract_id",
    "version",
    "agent_id",
    "review_owner",
    "capability_surface_id",
    "permission_knife_ids",
    "evidence_policy",
    "approved_at",
    "approval_signature"
  ],
  "properties": {
    "contract_id": { "type": "string" },
    "version": { "type": "string" },
    "agent_id": { "type": "string" },
    "review_owner": { "type": "string", "format": "email" },
    "capability_surface_id": { "type": "string", "format": "uuid" },
    "permission_knife_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "minItems": 1
    },
    "evidence_policy": {
      "type": "object",
      "required": ["receipt_sink", "retention_days", "lineage_required"],
      "properties": {
        "receipt_sink": { "type": "string" },
        "retention_days": { "type": "integer", "minimum": 1 },
        "lineage_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "approved_at": { "type": "string", "format": "date-time" },
    "approval_signature": { "type": "string" }
  },
  "additionalProperties": false
}
