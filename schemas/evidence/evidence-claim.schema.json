{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/evidence/evidence-claim.schema.json",
  "title": "EvidenceClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_claim"],
  "properties": {
    "evidence_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "source_type",
        "source_ref",
        "observable",
        "inspected_by",
        "inspection_method",
        "confidence",
        "limitations",
        "retention_class",
        "content_hash"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "observable": { "type": "string", "minLength": 1 },
        "inspected_by": { "type": "string", "minLength": 1 },
        "inspection_method": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "retention_class": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "minLength": 1 }
      }
    }
  }
}
