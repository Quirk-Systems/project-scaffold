{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/quirk-event.schema.json",
  "title": "Universal Quirk Event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "actor",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^qevt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "eventVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "agent",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^quirk://"
        }
      }
    },
    "payload": {}
  }
}
