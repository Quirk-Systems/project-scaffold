{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/governance/authority-grant.schema.json",
  "title": "AuthorityGrant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "principal",
    "grantee",
    "grant_scope",
    "permitted_verdict_effects",
    "issued_at",
    "expires_at",
    "delegation",
    "evidence_requirement",
    "grant_hash"
  ],
  "properties": {
    "grant_id": { "type": "string", "minLength": 1 },
    "principal": { "type": "string", "minLength": 1 },
    "grantee": { "type": "string", "minLength": 1 },
    "grant_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realms", "subjects", "target_classes"],
      "properties": {
        "realms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "target_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "permitted_verdict_effects": { "$ref": "#/$defs/effects" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "superseded_by_grant_id": { "type": "string", "minLength": 1 },
    "supersedes_grant_id": { "type": "string", "minLength": 1 },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_delegation"],
      "properties": {
        "allow_delegation": { "type": "boolean" }
      }
    },
    "delegated_from_grant_id": { "type": "string", "minLength": 1 },
    "evidence_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "classes"],
      "properties": {
        "required": { "type": "boolean" },
        "classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "grant_hash": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_observe", "may_recommend", "may_block", "may_approve"],
      "properties": {
        "may_observe": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "may_recommend": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "may_block": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "may_approve": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
