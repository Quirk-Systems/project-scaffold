# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase Postgres)
# Use the Session/Transaction pooler connection string from Supabase.
DATABASE_URL=postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Magic-link/transactional sender address (verified Resend domain in prod)
AUTH_EMAIL_FROM=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Stripe — keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET is printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# AI — Anthropic / Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Media storage — Supabase Storage (project settings -> API)
# Service-role key is SERVER-ONLY; the private quirk-assets bucket is
# auto-created on first upload.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog — analytics + feature flags (unset = no-op)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Skip env validation during build (CI/Docker)
# SKIP_ENV_VALIDATION=1
