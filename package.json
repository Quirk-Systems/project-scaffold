{
  "name": "project-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "bun run db:migrate",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "rm -f local.db local.db-journal && bun run db:migrate",
    "db:seed": "bun run scripts/seed.ts",
    "deps:audit": "bun run scripts/deps-audit.ts",
    "docs:ideas": "bun run scripts/generate-ideas-doc.ts && prettier --write docs/recommendations/wild/IDEAS.md",
    "email:dev": "email dev --dir src/emails --port 3001",
    "clean": "rm -rf .next out node_modules",
    "validate": "bun run format:check && bun run lint && bun run type-check && bun run test:run && SKIP_ENV_VALIDATION=1 bun run build",
    "validate:full": "bun run validate && bun run test:e2e",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@supabase/supabase-js": "^2.110.0",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "better-sqlite3": "^11.7.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "posthog-js": "^1.396.6",
    "posthog-node": "^5.39.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "resend": "^6.17.1",
    "sonner": "^2.0.7",
    "stripe": "^22.3.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "~3.2.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "lefthook": "^1.10.10",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react-email": "^6.6.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "~3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "shell-quote": "^1.9.0"
  }
}
